+static void mt7615_eeprom_save_txpower(struct mt7615_dev *dev)
+{
+	u8 *eep = dev->mt76.eeprom.data;
+	int i;
+
+	BUILD_BUG_ON(ARRAY_SIZE(dev->txpower_orig[0]) != __MT_CH_MAX);
+
+	if (!is_mt7663(&dev->mt76))
+		return;
+
+	for (i = 0; i < __MT_CH_MAX; i++) {
+		dev->txpower_orig[0][i] =
+			eep[MT7663_EE_TX0_5G_G0_TARGET_POWER + i * 3];
+		dev->txpower_orig[1][i] =
+			eep[MT7663_EE_TX1_5G_G0_TARGET_POWER + i * 3];
+	}
+}
+
+/* The MT7663/MT7613 AP firmware reads its channel power limits from the
+ * EFUSE buffer when it initialises and ignores later per-rate/low-power
+ * requests. Send it the factory table again with the per-chain target
+ * lowered from the configured power. The written value is always the
+ * minimum of the factory value and the requested cap, so this can only
+ * reduce the target, never raise it above the calibrated one.
+ */
+int mt7615_eeprom_set_txpower_cap(struct mt7615_dev *dev, int target)
+{
+	u8 *eep = dev->mt76.eeprom.data;
+	int i;
+
+	if (!is_mt7663(&dev->mt76))
+		return -EOPNOTSUPP;
+
+	target = clamp_t(int, target, 0, 0x3f);
+	for (i = 0; i < __MT_CH_MAX; i++) {
+		u8 tx0 = dev->txpower_orig[0][i];
+		u8 tx1 = dev->txpower_orig[1][i];
+
+		/* leave unset/absent calibration entries untouched */
+		if (tx0 != 0xff)
+			eep[MT7663_EE_TX0_5G_G0_TARGET_POWER + i * 3] =
+				min_t(u8, tx0, target);
+		if (tx1 != 0xff)
+			eep[MT7663_EE_TX1_5G_G0_TARGET_POWER + i * 3] =
+				min_t(u8, tx1, target);
+	}
+
+	return mt7615_mcu_set_eeprom(dev);
+}
