+static void mt7615_apply_txpower(struct mt7615_phy *phy, int power)
+{
+	struct mt7615_dev *dev = phy->dev;
+	int tx_power;
+
+	/* no limit known yet (boot, or user "auto"): keep the factory table */
+	if (power <= 0 || phy->txpower_target == power)
+		return;
+
+	tx_power = power * 2;
+	tx_power -= mt76_tx_power_path_delta(hweight8(phy->mt76->antenna_mask));
+	tx_power = max_t(int, tx_power, 0);
+
+	if (mt7615_eeprom_set_txpower_cap(dev, tx_power))
+		return;
+
+	phy->txpower_target = power;
+	mt7615_mcu_set_chan_info(phy, MCU_EXT_CMD(CHANNEL_SWITCH));
+}
