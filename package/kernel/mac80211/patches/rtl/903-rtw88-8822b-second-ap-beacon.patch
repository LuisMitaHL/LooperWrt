+static int rtw_pci_tx_write_beacon(struct rtw_dev *rtwdev,
+				   struct rtw_tx_pkt_info *pkt_info,
+				   struct sk_buff *skb)
+{
+	struct rtw_pci *rtwpci = (struct rtw_pci *)rtwdev->priv;
+	struct rtw_pci_tx_ring *ring;
+	int ret;
+
+	/* beacons ride the mgmt ring, the only per-frame path on PCIe */
+	pkt_info->qsel = TX_DESC_QSEL_MGMT;
+	ret = rtw_pci_tx_write_data(rtwdev, pkt_info, skb, RTW_TX_QUEUE_MGMT);
+	if (ret)
+		return ret;
+
+	ring = &rtwpci->tx_rings[RTW_TX_QUEUE_MGMT];
+	spin_lock_bh(&rtwpci->irq_lock);
+	if (avail_desc(ring->r.wp, ring->r.rp, ring->r.len) < 2) {
+		ieee80211_stop_queue(rtwdev->hw, skb_get_queue_mapping(skb));
+		ring->queue_stopped = true;
+	}
+	spin_unlock_bh(&rtwpci->irq_lock);
+
+	rtw_pci_tx_kick_off_queue(rtwdev, RTW_TX_QUEUE_MGMT);
+
+	return 0;
+}
