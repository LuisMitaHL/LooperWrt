+static void rtw_sw_beacon_send_iter(void *data, struct ieee80211_vif *vif)
+{
+	struct rtw_dev *rtwdev = data;
+	struct rtw_vif *rtwvif = (struct rtw_vif *)vif->drv_priv;
+	struct rtw_tx_pkt_info pkt_info = {};
+	struct sk_buff *skb;
+	u16 tim_off, tim_len;
+
+	if (vif->type != NL80211_IFTYPE_AP || !vif->bss_conf.enable_beacon)
+		return;
+	/* the page owner is already beamed by the firmware */
+	if (vif == rtwdev->fw_beacon_vif)
+		return;
+
+	skb = ieee80211_beacon_get_tim(rtwdev->hw, vif, &tim_off, &tim_len, 0);
+	if (!skb)
+		return;
+
+	pkt_info.tx_pkt_size = skb->len;
+	pkt_info.offset = rtwdev->chip->tx_pkt_desc_sz;
+	pkt_info.mac_id = rtwvif->mac_id;
+	if (rtwdev->hal.current_band_type == RTW_BAND_2G) {
+		pkt_info.rate_id = RTW_RATEID_B_20M;
+		pkt_info.rate = DESC_RATE1M;
+	} else {
+		pkt_info.rate_id = RTW_RATEID_G;
+		pkt_info.rate = DESC_RATE6M;
+	}
+	pkt_info.use_rate = true;
+	pkt_info.dis_rate_fallback = true;
+	pkt_info.qsel = TX_DESC_QSEL_MGMT;
+	pkt_info.bmc = true;
+	pkt_info.ls = true;
+	pkt_info.dis_qselseq = true;
+	pkt_info.en_hwseq = true;
+	pkt_info.hw_ssn_sel = 0;
+
+	if (rtw_tx_write_sw_beacon(rtwdev, &pkt_info, skb)) {
+		rtw_warn(rtwdev, "failed to submit beacon on port %u\n",
+			 rtwvif->port);
+		dev_kfree_skb_any(skb);
+	}
+}
+
+struct rtw_beacon_elect_data {
+	struct ieee80211_vif *leaving;
+	struct ieee80211_vif *owner;
+};
+
+static void rtw_beacon_elect_iter(void *data, struct ieee80211_vif *vif)
+{
+	struct rtw_beacon_elect_data *elect = data;
+
+	if (elect->owner || vif->type != NL80211_IFTYPE_AP ||
+	    vif == elect->leaving || !vif->bss_conf.enable_beacon)
+		return;
+
+	elect->owner = vif;
+}
+
+/* keep the firmware beacon page alive when its owner goes away */
+static void rtw_fw_reelect_beacon_vif(struct rtw_dev *rtwdev,
+				      struct ieee80211_vif *leaving)
+{
+	struct rtw_beacon_elect_data elect = {
+		.leaving = leaving,
+	};
+
+	if (rtwdev->fw_beacon_vif != leaving)
+		return;
+
+	rtwdev->fw_beacon_vif = NULL;
+	rtw_iterate_vifs(rtwdev, rtw_beacon_elect_iter, &elect);
+	if (!elect.owner)
+		return;
+
+	rtwdev->fw_beacon_vif = elect.owner;
+	rtwdev->fw_beacon_dtim = elect.owner->bss_conf.dtim_period;
+	rtw_set_dtim_period(rtwdev, rtwdev->fw_beacon_dtim);
+	rtw_fw_download_rsvd_page(rtwdev);
+
+	rtw_dbg(rtwdev, RTW_DBG_STATE,
+		"firmware beacon page moved to %pM\n", elect.owner->addr);
+}
+
+static void rtw_sw_beacon_work(struct work_struct *work)
+{
+	struct rtw_dev *rtwdev = container_of(work, struct rtw_dev,
+					      sw_beacon_work);
+
+	if (!rtw_sw_beacon || rtwdev->ap_active < 2)
+		return;
+
+	mutex_lock(&rtwdev->mutex);
+	rtw_iterate_vifs(rtwdev, rtw_sw_beacon_send_iter, rtwdev);
+	mutex_unlock(&rtwdev->mutex);
+}
+
+static enum hrtimer_restart rtw_sw_beacon_timer_fn(struct hrtimer *timer)
+{
+	struct rtw_dev *rtwdev = container_of(timer, struct rtw_dev,
+					      sw_beacon_timer);
+
+	ieee80211_queue_work(rtwdev->hw, &rtwdev->sw_beacon_work);
+	hrtimer_forward_now(timer,
+			    ns_to_ktime((u64)rtwdev->sw_beacon_int_us * 1000));
+
+	return HRTIMER_RESTART;
+}
