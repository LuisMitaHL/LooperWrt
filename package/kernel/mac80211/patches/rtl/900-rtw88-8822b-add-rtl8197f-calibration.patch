@@ -83,6 +218,12 @@ static int rtw8822b_read_efuse(struct rt
 		return -ENOTSUPP;
 	}
 
+	if (efuse->rfe_option == 0xff) {
+		ret = rtw8822b_read_rtl8197f_calibration(rtwdev);
