--- a/drivers/net/wireless/realtek/rtw88/mac80211.c
+++ b/drivers/net/wireless/realtek/rtw88/mac80211.c
@@ -6,6 +6,7 @@
 #include "sec.h"
 #include "tx.h"
 #include "fw.h"
+#include "phy.h"
 #include "mac.h"
 #include "coex.h"
 #include "ps.h"
@@ -71,6 +72,24 @@ static void rtw_ops_stop(struct ieee80211_hw *hw, bool suspend)
 	mutex_unlock(&rtwdev->mutex);
 }
 
+/*
+ * Apply a TX power cap from mac80211. Must be called with rtwdev->mutex held.
+ * dbm is the effective total: mac80211 already took min(regulatory, user, ap),
+ * so this is correct for NL80211_TX_POWER_FIXED and _LIMITED alike, and is a
+ * no-op (equals the regulatory max) when no user request is active.
+ */
+static void rtw_set_tx_power(struct rtw_dev *rtwdev, int dbm)
+{
+	struct rtw_hal *hal = &rtwdev->hal;
+
+	if (dbm == INT_MIN)
+		return;
+
+	hal->txpwr_cap_set = true;
+	hal->txpwr_cap_dbm = dbm;
+	rtw_phy_set_tx_power_level(rtwdev, hal->current_channel);
+}
+
 static int rtw_ops_config(struct ieee80211_hw *hw, int radio_idx, u32 changed)
 {
 	struct rtw_dev *rtwdev = hw->priv;
@@ -94,6 +113,8 @@ static int rtw_ops_config(struct ieee80211_hw *hw, int radio_idx, u32 changed)
 
 	if (changed & IEEE80211_CONF_CHANGE_CHANNEL)
 		rtw_set_channel(rtwdev);
+	else if (changed & IEEE80211_CONF_CHANGE_POWER)
+		rtw_set_tx_power(rtwdev, rtwdev->hw->conf.power_level);
 
 	if ((changed & IEEE80211_CONF_CHANGE_IDLE) &&
 	    (hw->conf.flags & IEEE80211_CONF_IDLE) &&
@@ -454,6 +475,9 @@ static void rtw_ops_bss_info_changed(struct ieee80211_hw *hw,
 	if (changed & BSS_CHANGED_PS)
 		rtw_recalc_lps(rtwdev, NULL);
 
+	if (changed & BSS_CHANGED_TXPOWER)
+		rtw_set_tx_power(rtwdev, conf->txpower);
+
 	rtw_vif_port_config(rtwdev, rtwvif, config);
 
 	mutex_unlock(&rtwdev->mutex);
@@ -944,6 +968,21 @@ static void rtw_ops_sta_rc_update(struct ieee80211_hw *hw,
 		ieee80211_queue_work(rtwdev->hw, &si->rc_work);
 }
 
+static int rtw_ops_get_txpower(struct ieee80211_hw *hw,
+			       struct ieee80211_vif *vif,
+			       unsigned int link_id, int *dbm)
+{
+	struct rtw_dev *rtwdev = hw->priv;
+	struct rtw_hal *hal = &rtwdev->hal;
+
+	if (hal->txpwr_cap_set)
+		*dbm = hal->txpwr_cap_dbm;
+	else
+		*dbm = hal->tx_pwr_tbl[0][DESC_RATE6M] >> rtwdev->chip->txgi_factor;
+
+	return 0;
+}
+
 const struct ieee80211_ops rtw_ops = {
 	.add_chanctx = ieee80211_emulate_add_chanctx,
 	.remove_chanctx = ieee80211_emulate_remove_chanctx,
@@ -965,6 +1004,7 @@ const struct ieee80211_ops rtw_ops = {
 	.sta_add		= rtw_ops_sta_add,
 	.sta_remove		= rtw_ops_sta_remove,
 	.set_tim		= rtw_ops_set_tim,
+	.get_txpower		= rtw_ops_get_txpower,
 	.set_key		= rtw_ops_set_key,
 	.ampdu_action		= rtw_ops_ampdu_action,
 	.can_aggregate_in_amsdu	= rtw_ops_can_aggregate_in_amsdu,
