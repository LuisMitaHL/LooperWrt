# SPDX-License-Identifier: GPL-2.0-only
# Provisional RTL8197F-class Stage 0 kernel scaffold.

CONFIG_MACH_REALTEK_RTL819X=y
CONFIG_CPU_MIPS32_R2=y
# CONFIG_CPU_MIPS32_R1 is not set
# 24Kc has no hardware FPU; the kernel still needs FP support to accept the
# FP-ABI userspace binaries (else /sbin/init fails to exec with -ENOEXEC) and
# to emulate any floating point.
CONFIG_MIPS_FP_SUPPORT=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_PAGE_BLOCK_MAX_ORDER=10

CONFIG_COMMON_CLK=y
CONFIG_CEVT_R4K=y
CONFIG_CSRC_R4K=y
CONFIG_IRQ_DOMAIN=y
CONFIG_IRQ_MIPS_CPU=y
CONFIG_IRQ_REALTEK_RTL8197F=y

CONFIG_OF=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_IRQ=y
CONFIG_USE_OF=y

CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# devtmpfs auto-populates /dev (incl. /dev/ttyS0) so procd's askconsole can
# find the console tty and spawn the login shell. Without it /dev has no
# ttyS0 node, askconsole skips it, and no console prompt ever appears.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250_NR_UARTS=3
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_EARLY_PRINTK=y
CONFIG_SYS_HAS_EARLY_PRINTK=y
# CONFIG_EARLY_PRINTK_8250 is not set
# CONFIG_USE_GENERIC_EARLY_PRINTK_8250 is not set

CONFIG_MIPS_RAW_APPENDED_DTB=y
# CONFIG_MIPS_NO_APPENDED_DTB is not set
CONFIG_MIPS_CMDLINE_FROM_DTB=y
# CONFIG_MIPS_CMDLINE_FROM_BOOTLOADER is not set

CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_NVMEM=y
CONFIG_NVMEM_LAYOUTS=y
CONFIG_WLAN_VENDOR_REALTEK=y
# CONFIG_RTL8197F_WIFI_DIAG is not set
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_MEM=y
CONFIG_SPI_REALTEK_SHEIPA=y

# RTL8197F on-SoC CPU NIC (internal switch CPU port), polled bring-up driver.
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_RTL8197F_ETH=y

# Stage 1 and later only.
# CONFIG_NET_RTL838X is not set
# CONFIG_PCS_RTL_OTTO is not set

# Wired LAN: external RTL8367RB-VB switch on GPIO-SMI, driven by the mainline
# realtek DSA driver (rtl8365mb). eth0 (rtl8197f-eth) is the DSA conduit.
CONFIG_GPIO_GENERIC=y
CONFIG_GPIO_GENERIC_PLATFORM=y
CONFIG_NET_DSA=y
CONFIG_NET_DSA_REALTEK=y
CONFIG_NET_DSA_REALTEK_SMI=y
CONFIG_NET_DSA_REALTEK_RTL8365MB=y
CONFIG_NET_DSA_TAG_RTL8_4=y
CONFIG_REALTEK_PHY=y
CONFIG_FIXED_PHY=y
CONFIG_PHYLINK=y
CONFIG_REGMAP=y
# CONFIG_NET_DSA_REALTEK_MDIO is not set
CONFIG_PCI=y
CONFIG_PCI_DRIVERS_GENERIC=y
CONFIG_PCIE_RTL8197F=y
CONFIG_GENERIC_PCI_IOMAP=y
CONFIG_PCI_DOMAINS=y
# CONFIG_KALLSYMS_UNCOMPRESSED is not set

